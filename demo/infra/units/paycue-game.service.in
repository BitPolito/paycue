[Unit]
Description=Orbital Sats, the Paycue showcase game
After=paycue-payouts.service paycue-wallet.service
Wants=paycue-payouts.service paycue-wallet.service

[Service]
WorkingDirectory=@DEMO_DIR@/game
Environment=PAYCUE_DEMO_HOME=@PAYCUE_HOME@
Environment=GAME_PORT=8090
Environment=WALLET_DOMAIN=@WALLET_DOMAIN@
Environment=WALLET_PUBLIC_URL=@WALLET_PUBLIC_URL@
ExecStart=@NODE@ --disable-warning=ExperimentalWarning dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
