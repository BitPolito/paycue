[Unit]
Description=Paycue contribution reward demo (GitHub bounties)
After=paycue-payouts.service
Wants=paycue-payouts.service

[Service]
WorkingDirectory=@DEMO_DIR@/contributions
Environment=PAYCUE_DEMO_HOME=@PAYCUE_HOME@
Environment=CONTRIB_PORT=8092
Environment=WALLET_PUBLIC_URL=@WALLET_PUBLIC_URL@
# GITHUB_WEBHOOK_SECRET, and optionally GITHUB_REPO and GITHUB_TOKEN.
EnvironmentFile=-@PAYCUE_HOME@/contributions/env
ExecStart=@NODE@ --disable-warning=ExperimentalWarning dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
