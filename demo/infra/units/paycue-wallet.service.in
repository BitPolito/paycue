[Unit]
Description=Paycue demo player wallet (Lightning Address + Liquid)
After=paycue-lnd@player.service
Wants=paycue-lnd@player.service

[Service]
WorkingDirectory=@DEMO_DIR@/player-wallet
Environment=PAYCUE_DEMO_HOME=@PAYCUE_HOME@
Environment=WALLET_PORT=8091
Environment=WALLET_DOMAIN=@WALLET_DOMAIN@
ExecStart=@NODE@ --experimental-wasm-modules --disable-warning=ExperimentalWarning dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
