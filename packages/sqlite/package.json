{
  "name": "@payhook/sqlite",
  "version": "0.2.0",
  "description": "SQLite storage for Payhook, on Node's built-in node:sqlite",
  "keywords": [
    "payhook",
    "sqlite"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
